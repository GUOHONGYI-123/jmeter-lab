{
"name": "jmeter-lab",
"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
"features": {
"ghcr.io/devcontainers/features/java:1": { "version": "17" },
"ghcr.io/devcontainers/features/desktop-lite:1": {}
},
"remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/jmeter/bin" },
"forwardPorts": [6080, 8000],
"portsAttributes": {
"6080": { "label": "noVNC Desktop", "onAutoForward": "openBrowser" },
"8000": { "label": "HTML Report", "onAutoForward": "notify" }
},
"postCreateCommand": "mkdir -p ~/jmeter && curl -fsSL https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-5.6.3.tgz
}
